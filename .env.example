# Local Postgres from docker compose, or any Postgres 16 you already have.
DATABASE_URL=postgresql+psycopg2://promo:promo@127.0.0.1:5432/promo_lift

# Set to 1 to load the full Complete Journey mirrors (the default).
# Set to 0 only if you intentionally want a smaller promotions slice.
FULL_BUILD=1

