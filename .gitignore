.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.env
*.pyc
.DS_Store
.streamlit/secrets.toml

# Raw downloads and the full processed cache stay local.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/fixtures/
!data/fixtures/**

# Parquet extracts are regenerated by `make export`. CSV, the data dictionary,
# and the Excel briefing stay in the repo when they are small enough to read.
exports/bi/*.parquet
exports/bi/dim_product.csv
exports/briefs/*
!exports/briefs/.gitkeep
!exports/bi/.gitkeep
!exports/excel/.gitkeep

# Local scratch
tmp/
*.log
